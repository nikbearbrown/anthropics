    {
      "beat_id": "A21",
      "act": "ACT 2",
      "lane": "REMOTION",
      "narration_text": "Three supporting endpoints orbit Messages. Files: upload binary data too large for inline — PDFs, images, reference docs — and get back a file_id you embed in messages. Batches: submit arrays of requests processed asynchronously at lower cost, a 50% discount at scale. Streaming: server-sent events for incremental token delivery. These aren't alternatives to Messages — they extend how Messages receives or delivers data.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "estimated_duration_s": 26,
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "form": "claude_window",
        "remotion": {
          "pattern": "ClaudeWindow",
          "props": {
            "view": "artifact",
            "artifactTitle": "Supporting Endpoints",
            "artifactHeading": "Three endpoints orbit Messages.",
            "artifactLines": [
              "Files API — upload docs; get file_id.",
              "Batches API — async; 50% cost at scale.",
              "Streaming — server-sent events; token stream."
            ],
            "sparkLine": "Not alternatives — they extend how Messages delivers."
          },
          "rendered": {
