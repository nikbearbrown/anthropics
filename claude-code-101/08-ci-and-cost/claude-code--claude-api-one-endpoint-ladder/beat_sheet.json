    {
      "beat_id": "A11",
      "act": "ACT 1",
      "lane": "REMOTION",
      "narration_text": "Every Claude API call goes through POST /v1/messages. The model ID, the messages array, the system prompt, the max_tokens cap — these are the four required shapes. Tool definitions and response_format are parameter flags on the same request. There is no separate structured-output API. There is no separate tool-calling API. One surface, one message shape, progressive feature unlock via parameters.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "estimated_duration_s": 26,
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "form": "claude_window",
        "remotion": {
          "pattern": "ClaudeWindow",
          "props": {
            "view": "artifact",
            "artifactTitle": "POST /v1/messages",
            "artifactHeading": "One surface. Four required shapes.",
            "artifactLines": [
              "model — the ID",
              "messages[] — the conversation array",
              "system — the system prompt",
              "max_tokens — the cap",
              "tools[] / response_format — parameter flags, same request"
            ],
            "sparkLine": "One endpoint. Progressive unlock via parameters."
          },
          "rendered": {
