{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YJWKz6vqRLHjUp6MLMpjTN","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"check_summary.py — definition of done for the exec-summary skill.\n3\tUsage: python3 check_summary.py summary.md\n4\tPrints PASS or the first FAIL line.\"\"\"\n5\timport re, sys, pathlib\n6\t\n7\tdef check(p: pathlib.Path) -> str:\n8\t    if not p.exists():\n9\t        return f\"FAIL: {p} does not exist\"\n10\t    text = p.read_text(encoding=\"utf-8\")\n11\t    needed = [\"## What\", \"## Why it matters\", \"## What's new\", \"## What to do\"]\n12\t    for h in needed:\n13\t        if h not in text:\n14\t            return f\"FAIL: missing heading '{h}'\"\n15\t    order = [text.index(h) for h in needed]\n16\t    if order != sorted(order):\n17\t        return \"FAIL: headings out of order\"\n18\t    if re.search(r\"\\b\\d{1,3}\\s*/\\s*\\d{1,3}\\b|\\b\\d{1,3}%\\b|Grade:\\s*[A-DF][+\\-]?\", text):\n19\t        return \"FAIL: numeric rating or letter grade found\"\n20\t    if re.search(r\"[\\U0001F300-\\U0001FAFF\\U00002600-\\U000027BF]\", text):\n21\t        return \"FAIL: emoji found\"\n22\t    if re.search(r\"^\\s*TL;DR\", text, flags=re.MULTILINE|re.IGNORECASE):\n23\t        return \"FAIL: TL;DR line before sections\"\n24\t    if re.search(r\"\\bstar\\s?rating\\b|★|☆\", text):\n25\t        return \"FAIL: star rating found\"\n26\t    return \"PASS\"\n27\t\n28\tif __name__ == \"__main__\":\n29\t    if len(sys.argv) != 2:\n30\t        sys.exit(\"usage: check_summary.py <path>\")\n31\t    print(check(pathlib.Path(sys.argv[1])))\n32\t"}]},"parent_tool_use_id":null,"session_id":"33333333-3333-3333-3333-333333333333","uuid":"b748931a-7bdc-4053-ab7b-67623646bd44","timestamp":"2026-09-10T09:47:40.030Z","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/cc-claude-skills-scratch/.claude/skills/exec-summary/check_summary.py","content":"#!/usr/bin/env python3\n\"\"\"check_summary.py — definition of done for the exec-summary skill.\nUsage: python3 check_summary.py summary.md\nPrints PASS or the first FAIL line.\"\"\"\nimport re, sys, pathlib\n\ndef check(p: pathlib.Path) -> str:\n    if not p.exists():\n        return f\"FAIL: {p} does not exist\"\n    text = p.read_text(encoding=\"utf-8\")\n    needed = [\"## What\", \"## Why it matters\", \"## What's new\", \"## What to do\"]\n    for h in needed:\n        if h not in text:\n            return f\"FAIL: missing heading '{h}'\"\n    order = [text.index(h) for h in needed]\n    if order != sorted(order):\n        return \"FAIL: headings out of order\"\n    if re.search(r\"\\b\\d{1,3}\\s*/\\s*\\d{1,3}\\b|\\b\\d{1,3}%\\b|Grade:\\s*[A-DF][+\\-]?\", text):\n        return \"FAIL: numeric rating or letter grade found\"\n    if re.search(r\"[\\U0001F300-\\U0001FAFF\\U00002600-\\U000027BF]\", text):\n        return \"FAIL: emoji found\"\n    if re.search(r\"^\\s*TL;DR\", text, flags=re.MULTILINE|re.IGNORECASE):\n        return \"FAIL: TL;DR line before sections\"\n    if re.search(r\"\\bstar\\s?rating\\b|★|☆\", text):\n        return \"FAIL: star rating found\"\n    return \"PASS\"\n\nif __name__ == \"__main__\":\n    if len(sys.argv) != 2:\n        sys.exit(\"usage: check_summary.py <path>\")\n    print(check(pathlib.Path(sys.argv[1])))\n","numLines":32,"startLine":1,"totalLines":32}}}
