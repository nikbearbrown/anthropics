    {
      "beat_id": "B05",
      "act": "verdict",
      "scene": "PIPELINE",
      "narration_text": "Who this is for: anyone whose skill library grew faster than their understanding of it. Skip if you only run skills you wrote yourself. Note: this playlist and the agent-skills playlist are deliberately split — writing your own versus judging someone else's. If that split doesn't hold, this is the reel to rebuild. Falsifiable line: if a skill's stated description accurately predicts its behavior in every case, reading the SKILL.md adds no value.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "estimated_duration_s": 22.0,
      "shot": {
        "type": "REMOTION",
        "remotion": {
          "pattern": "ClaudeWindow",
          "props": {
            "view": "artifact",
            "artifactTitle": "Verdict",
            "artifactHeading": "Who this is for",
            "artifactLines": [
              "FOR: Skill library grew faster than your understanding.",
              "WHY: Installing a skill is delegating judgment.",
              "FIX: Read the SKILL.md before you run the skill.",
              "SKIP: You wrote every skill you run? No need.",
              "DO NOW: Open one skill you use and read it cold.",
              "TEST: Does the description match what it actually does?",
              "EXPECT: At least one surprise in the first read.",
              "FALSIFIABLE: Description predicts behavior perfectly? No audit needed."
            ],
            "sparkLine": "A skill you haven't read is a trust you haven't earned."
          },
          "rendered": {
