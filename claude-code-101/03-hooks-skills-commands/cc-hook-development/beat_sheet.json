        "type": "REMOTION",
        "source": "own",
        "motion": "type",
        "remotion": {
          "pattern": "CCSession",
          "props": {
            "title": "scratch — two events",
            "mode": "default",
            "blocks": [
              {
                "type": "text",
                "text": "PostToolUse:  fires AFTER  (log)"
              },
              {
                "type": "text",
                "text": "PreToolUse:   fires BEFORE (block)"
              },
              {
                "type": "text",
                "text": "exit 0  → nothing"
              },
