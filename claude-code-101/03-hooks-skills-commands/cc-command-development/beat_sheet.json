      "beat_id": "BDEFS",
      "act": "DEFINITIONS",
      "lane": "CARD",
      "narration_text": "Five words. A slash command is a Markdown file whose text becomes Claude's next instruction. Dot-claude-slash-commands: the project folder — every .md here becomes one command. Frontmatter: YAML at the top — description, allowed-tools, and an argument hint. Allowed-tools: what the command intends to use — Read, Grep, or Bash fenced to git. Dollar-arguments, or dollar-one: everything typed after the slash name; dollar-one grabs the first argument.",
      "estimated_duration_s": 24.0,
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "new_visual_element": "CCDefinitions — five terms",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "drawon",
        "remotion": {
          "pattern": "CCDefinitions",
          "props": {
            "title": "TERMS IN THIS FILM",
            "terms": [
              {
                "term": "slash command",
                "meaning": "a Markdown file whose text becomes Claude's next instruction"
              },
              {
                "term": ".claude/commands/",
                "meaning": "the project folder; every .md here becomes one command"
              },
              {
                "term": "frontmatter",
                "meaning": "YAML at the top — description, allowed-tools, argument-hint"
              },
              {
                "term": "allowed-tools",
                "meaning": "which tools the command intends to use, e.g. Read, Grep"
              },
              {
                "term": "$ARGUMENTS / $1",
                "meaning": "everything typed after /name; $1 grabs the first argument"
              }
