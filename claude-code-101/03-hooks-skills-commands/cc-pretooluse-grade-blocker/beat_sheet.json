    {
      "beat_id": "BIDEA",
      "act": "THE IDEA",
      "lane": "IDEA",
      "narration_text": "Here's the idea of this film. A note in CLAUDE.md is a hope — the model reads it, weights it, sometimes overrides it. A PreToolUse hook is a fence. It runs between the model and disk on every Write, sees what's about to be written, and can refuse. So we build one. Thirty-six lines of Python, wired in fifteen lines of JSON, and the same ask stops behaving the same way.",
      "estimated_duration_s": 25.4,
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "new_visual_element": "BrutalistHesitantWriter — 'hope' reconsidered into 'hook'",
      "shot": {
