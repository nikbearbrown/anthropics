        "type": "REMOTION",
        "source": "own",
        "motion": "drawon",
        "remotion": {
          "pattern": "CCDefinitions",
          "props": {
            "title": "TERMS IN THIS FILM",
            "terms": [
              {
                "term": "fix-forward",
                "meaning": "reply with another correction in the same session — history stays in context"
              },
              {
                "term": "/rewind",
                "meaning": "interactive command restoring conversation + files to a checkpoint"
