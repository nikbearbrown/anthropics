    {
      "beat_id": "B05",
      "act": "verdict",
      "scene": "PIPELINE",
      "narration_text": "This is the highest-leverage playlist in the series and the highest blast radius. If you only watch one before touching production systems, watch this one. Falsifiable line: if every connector action is perfectly reversible and scoped to exactly what you intended, the blast-radius framing is overcautious.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "estimated_duration_s": 16.0,
      "shot": {
        "type": "REMOTION",
        "remotion": {
          "pattern": "ClaudeWindow",
          "props": {
            "view": "artifact",
            "artifactTitle": "Verdict",
            "artifactHeading": "Who this is for",
            "artifactLines": [
              "FOR: Anyone touching production with a connected agent.",
              "WHY: Connectors are hands, not knowledge — real blast radius.",
              "FIX: Write down what you want it to do while you sleep.",
              "SKIP: Nobody. Watch this before you connect anything.",
              "DO NOW: List write operations before you grant write access.",
              "TEST: Can it take an action you would not sanction?",
              "EXPECT: Blast radius is larger than you assumed.",
              "FALSIFIABLE: Every action scoped and reversible? Framing is overcautious."
            ],
            "sparkLine": "An agent can claim success while the world disagrees."
          },
          "rendered": {
            "out": "media/B05.mp4",
            "at": ""
          }
        }
      },
