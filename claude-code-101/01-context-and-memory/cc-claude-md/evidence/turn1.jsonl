{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N9HzxJZ9q8pVeafALyZmQP","type":"tool_result","content":"1\t\"\"\"gradebook — add students, record scores, print averages.\"\"\"\n2\timport json, sys\n3\tfrom pathlib import Path\n4\t\n5\tDB = Path(\"grades.json\")\n6\t\n7\t\n8\tdef load():\n9\t    return json.loads(DB.read_text()) if DB.exists() else {}\n10\t\n11\t\n12\tdef save(data):\n13\t    DB.write_text(json.dumps(data, indent=2))\n14\t\n15\t\n16\tdef add(name):\n17\t    data = load()\n18\t    data.setdefault(name, [])\n19\t    save(data)\n20\t    print(f\"added {name}\")\n21\t\n22\t\n23\tdef score(name, value):\n24\t    data = load()\n25\t    data.setdefault(name, []).append(float(value))\n26\t    save(data)\n27\t    print(f\"{name}: {value}\")\n28\t\n29\t\n30\tdef report():\n31\t    for name, scores in load().items():\n32\t        avg = sum(scores) / len(scores) if scores else 0.0\n33\t        print(f\"{name:12s} {avg:6.1f}\")\n34\t\n35\t\n36\tif __name__ == \"__main__\":\n37\t    cmd, *args = sys.argv[1:] or [\"report\"]\n38\t    {\"add\": add, \"score\": score, \"report\": report}[cmd](*args)\n39\t"}]},"parent_tool_use_id":null,"session_id":"fe0edef3-b504-4ce2-8996-386d9c3a68b7","uuid":"eb3013f7-4682-4c38-9993-66a406c8816e","timestamp":"2026-09-09T03:52:46.917Z","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/claude-501/-Users-bear-Documents-CoWork/9430e172-7c13-46d9-987f-7a913f7e069f/scratchpad/claudemd-session/src/gradebook.py","content":"\"\"\"gradebook — add students, record scores, print averages.\"\"\"\nimport json, sys\nfrom pathlib import Path\n\nDB = Path(\"grades.json\")\n\n\ndef load():\n    return json.loads(DB.read_text()) if DB.exists() else {}\n\n\ndef save(data):\n    DB.write_text(json.dumps(data, indent=2))\n\n\ndef add(name):\n    data = load()\n    data.setdefault(name, [])\n    save(data)\n    print(f\"added {name}\")\n\n\ndef score(name, value):\n    data = load()\n    data.setdefault(name, []).append(float(value))\n    save(data)\n    print(f\"{name}: {value}\")\n\n\ndef report():\n    for name, scores in load().items():\n        avg = sum(scores) / len(scores) if scores else 0.0\n        print(f\"{name:12s} {avg:6.1f}\")\n\n\nif __name__ == \"__main__\":\n    cmd, *args = sys.argv[1:] or [\"report\"]\n    {\"add\": add, \"score\": score, \"report\": report}[cmd](*args)\n","numLines":39,"startLine":1,"totalLines":39}}}
