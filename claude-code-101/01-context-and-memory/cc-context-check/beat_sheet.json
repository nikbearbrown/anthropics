      "beat_id": "BDEFS",
      "act": "DEFINITIONS",
      "lane": "CARD",
      "narration_text": "Five words before we start. Context window: the fixed amount the model can read at once — here, a million tokens. System prompt: the product's own standing instructions, loaded before yours. Tools: the descriptions of every tool the model may call; they take space whether or not it calls them. Messages: the conversation — your asks, its answers, every tool result. Autocompact buffer: room the product keeps in reserve so it can compact before the window fills.",
      "estimated_duration_s": 27.5,
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
