  },
  {
   "beat_id": "B03",
   "act": "key insight",
   "narration_text": "At 600 K hot and 300 K cold: efficiency is exactly 50%. You cannot do better with any engine operating between those two reservoirs. The Carnot limit is not an engineering target — it is a thermodynamic ceiling.",
   "voice": "am_onyx",
   "engine": "kokoro",
   "estimated_duration_s": 12,
   "shot": {
    "type": "REMOTION",
    "source": "remotion",
    "remotion": {
     "pattern": "FormACard",
     "props": {
      "lines": [
       "600 K / 300 K → η = 50%.",
       "No real engine exceeds this.",
       "Ceiling, not target."
      ],
      "dark": false
     },
     "rendered": {
