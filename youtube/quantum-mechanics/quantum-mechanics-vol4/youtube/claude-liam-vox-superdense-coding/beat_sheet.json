            "at": ""
          }
        }
      },
      "audio_file": "mp3/beat-B11.mp3",
      "build": {
        "status": "VIDEO",
        "src": "media/B11.mp4",
        "filled_by": "media",
        "at": "2026-07-18T23:04:03"
      }
    },
    {
      "beat_id": "B12",
      "estimated_duration_s": 8,
      "narration_text": "One qubit, two bits: not a free doubling, but one transmitted qubit amplified by one Bell pair shared in advance.",
