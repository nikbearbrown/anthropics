        "src": "media/B11.mp4",
        "filled_by": "media",
        "at": "2026-07-18T23:23:09"
      }
    },
    {
      "beat_id": "B12",
      "estimated_duration_s": 8,
      "narration_text": "Bigger code, fewer errors — below a conditional threshold, and only with the machinery of fault tolerance intact.",
