            "greeting": "Over to you, Liam",
            "runningText": "waiting for the scoped conclusion…",
            "output": [
              "Below crossing: larger distance improves logical error.",
              "Scope: this code, decoder, circuit, and noise model."
            ],
            "folderLabel": "@NikBearBrown",
