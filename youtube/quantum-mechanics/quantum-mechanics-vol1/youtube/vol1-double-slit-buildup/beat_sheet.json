   "beat_id": "B02",
   "act": "Manim exhibit — single-photon buildup",
   "narration_text": "One photon lands. Then another. Each at a random position, weighted by the interference probability. Early on it looks like noise. As detections accumulate, the fringes emerge — bright bands where the wave from both slits arrives in phase, dark bands where it cancels. The pattern is already in the first photon. You just cannot see it yet.",
   "voice": "am_onyx",
   "engine": "kokoro",
   "estimated_duration_s": 30,
   "shot": {
    "type": "VIDEO",
    "source": "own",
    "path": "media/B02.mp4"
   },
   "audio_file": "mp3/beat-B02.mp3",
   "actual_duration_s": 18.2,
   "build": {
