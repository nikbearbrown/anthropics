    "filled_by": "media",
    "at": "2026-07-27T18:32:10"
   }
  },
  {
   "beat_id": "B03",
   "act": "key insight",
   "narration_text": "The interference pattern is not caused by photons talking to each other. Each photon travels both paths simultaneously as a probability amplitude. The pattern is what the Born rule produces when you sample that amplitude many times.",
   "voice": "am_onyx",
   "engine": "kokoro",
   "estimated_duration_s": 12,
   "shot": {
    "type": "REMOTION",
    "source": "remotion",
    "remotion": {
     "pattern": "FormACard",
     "props": {
      "lines": [
       "No photon–photon interference.",
       "Each photon: both paths.",
       "Pattern = Born rule × N."
      ],
      "dark": false
     },
     "rendered": {
      "out": "media/B03.mp4",
      "at": ""
     }
    }
   },
   "audio_file": "mp3/beat-B03.mp3",
