  {
   "beat_id": "B09",
   "act": "RECAP",
   "shot_type": "CARD",
   "shot_source": "own",
   "shot_motion": "hold",
   "on_screen": [
    "Tests passing is not done.",
    "Done means the SDD's needs are met.",
    "Read them aloud. Before you commit."
   ],
   "narration_text": "Tests passing is not done. Done means the needs the SDD named are satisfied \u2014 a strictly larger claim. The test suite catches what it was written to catch. The user need that was never enrolled as a test can pass nine automated checks and still fail the person it was built for. Read the user-need sentences aloud against the running build. Every time. Pass 3 is the one you cannot skip.",
   "estimated_duration": 19,
   "audio_file": "mp3/beat-B09.mp3",
   "actual_duration_s": 19.88,
