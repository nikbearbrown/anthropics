  {
   "beat_id": "B08",
   "act": "THE PRACTICE",
   "shot_type": "GRAPHIC",
   "shot_source": "own",
   "shot_motion": "drawon",
   "on_screen": [
    "Before you commit:",
    "Open the SDD.",
    "Read each user-need sentence aloud.",
    "Check the running build against each one."
   ],
   "narration_text": "The practice is concrete. Before you commit, open the SDD to the User Needs section. Read each sentence aloud. After each sentence, look at the running build and ask: does a user who has not just built this experience the sentence as true? This is not a test. It is judgment. The at-a-glance need cannot be asserted by a runner. It has to be seen. The cheapest moment to run Pass 3 is right before the commit \u2014 when the build is live and the needs are fresh.",
   "estimated_duration": 22,
   "audio_file": "mp3/beat-B08.mp3",
   "actual_duration_s": 21.31,
