  {
   "beat_id": "B01",
   "act": "COLD OPEN",
   "shot_type": "CARD",
   "shot_source": "own",
   "shot_motion": "hold",
   "on_screen": [
    "npm test: 9 of 9 passing.",
    "The build is done.",
    "The user can't see their data at a glance."
   ],
   "narration_text": "This is Liam, in for Bear. Seth finishes Phase 1 of his college application tracker. Nine of nine tests pass. The page loads. Persistence works. He is about to commit. He re-reads the SDD aloud: 'The user should be able to see at a glance which applications remain to submit and which are already in.' He looks at the running build. Six applications scattered in insertion order. At a glance fails. Every test passed. The build failed its user.",
   "estimated_duration": 23,
   "audio_file": "mp3/beat-B01.mp3",
   "actual_duration_s": 21.76,
