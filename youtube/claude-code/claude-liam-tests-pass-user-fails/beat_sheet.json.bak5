  {
   "beat_id": "B05",
   "act": "THE MECHANISM",
   "shot_type": "STILL",
   "shot_source": "ai",
   "shot_motion": "kenburns",
   "on_screen": [],
   "narration_text": "Tony Hoare made the formal version of this argument in 1969. A program is correct with respect to a specification \u2014 never in the abstract. Correctness is a relation between code and spec, not a property of code alone. Tests are evidence about whether the code meets the spec. A test suite that does not include the user need is evidence about the wrong question.",
   "estimated_duration": 18,
   "audio_file": "mp3/beat-B05.mp3",
   "actual_duration_s": 19.54,
   "build": {
    "status": "SLATE",
    "src": null,
    "filled_by": null,
    "at": "2026-07-29T03:41:30",
    "needs": "PIPELINE \u2192 fill_slates/remotion_scenes for B05"
   },
   "shot": {
    "type": "REMOTION",
    "source": "own",
    "remotion": {
