      "blocks": [
       {
        "type": "prompt",
        "text": "Tony Hoare made the formal version of this argument in 1969. A program is correct with respect to a specification \u2014 neve\u2026",
        "cue": 0,
        "typeDuration": 60
       },
       {
        "type": "status",
        "verb": "Analyzing",
        "elapsed": "~3s"
       }
      ],
      "cues": [
