   "beat_id": "B03",
   "act": "CODE",
   "narration_text": "Read the diff before running. The change is minimal \u2014 one function touched, nothing outside auth slash touched. The test_empty_password_rejected function was missing the empty-string guard. One line added. That is scope discipline.",
   "estimated_duration_s": 15.0,
   "shot": {
    "type": "REMOTION",
    "source": "own",
    "motion": "fade",
    "remotion": {
     "pattern": "CCSession",
     "props": {
      "title": "project \u00b7 auth",
