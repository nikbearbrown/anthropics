    {
      "beat_id": "B03",
      "act": "CODE",
      "narration_text": "Claude writes the validator. It runs conditions via subprocess, requires exit code 0, stops on first FAIL, and names the blocking step.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "NikBearBrownCodeBlock",
          "props": {
            "filename": "handoff_validator.py",
            "topic": "CLAUDE CODE FOR STUDENTS",
            "segment": "HANDOFF CONDITIONS",
            "code": "# handoff_validator.py — Claude Code output\nimport json, subprocess, sys\n\ndef validate(score_path):\n    score = json.load(open(score_path))\n    for step in score['steps']:\n        condition = step['handoff_condition']\n        result = subprocess.run(\n            condition, shell=True, capture_output=True\n        )\n        status = 'PASS' if result.returncode == 0 else 'FAIL'\n        print(f\"Step {step['id']}: {status} -- {condition}\")\n        if result.returncode != 0:\n            print(f'BLOCKED: step {step[\"id\"]} must pass before continuing')\n            sys.exit(1)\n    print('All conditions PASS -- phase gate cleared')\n\nif __name__ == '__main__':\n    validate(sys.argv[1])"
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": ""
          }
        }
