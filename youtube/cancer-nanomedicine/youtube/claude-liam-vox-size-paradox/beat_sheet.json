            "items": [
              {
                "label": "Vessels leak",
                "sub": "Particles slip out through wall gaps.",
                "icon": "hand",
                "cueFrame": 20
              },
              {
                "label": "Lymph cannot clear",
                "sub": "Impaired drainage keeps them in.",
                "icon": "shield-alert",
                "cueFrame": 130
              },
              {
                "label": "Bigger stays longer",
                "sub": "More retention means more drug.",
                "icon": "snowflake",
                "cueFrame": 240
              }
            ]
