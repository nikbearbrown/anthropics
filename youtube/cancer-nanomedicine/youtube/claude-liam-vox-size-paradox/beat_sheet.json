    {
      "beat_id": "B05",
      "act": "THE PROBLEM",
      "lane": "BODY",
      "narration_text": "Here is the naive argument. Tumor blood vessels are leaky — particles slip out through gaps in their walls. Once outside, the impaired lymphatics cannot drain them back. So they stay. Bigger particles benefit more from this retention. More retained means more drug.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "estimated_duration_s": 14,
      "audio_file": "mp3/beat-B05.mp3",
