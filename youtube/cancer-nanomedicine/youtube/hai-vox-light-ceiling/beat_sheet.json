      }
    },
    {
      "beat_id": "B08",
      "act": "THE IMPLICATION",
      "t_start": 67.0,
      "estimated_duration_s": 10.0,
      "narration_text": "No formulation change moves the ceiling. A nanoparticle delivering drug ten times more efficiently still delivers it to a depth light cannot reach. The drug accumulation problem is solved. The activation problem is not. The ceiling is tissue optics, not chemistry.",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "voice": "am_onyx",
      "shot": {
        "type": "REMOTION",
        "source": "own",
