    {
      "beat_id": "B09",
      "act": "THE EXAMPLE",
      "t_start": 77.0,
      "estimated_duration_s": 12.0,
      "narration_text": "Two lesions. Barrett's esophagus, one millimeter deep. Submucosal tumor, twelve millimeters deep. Same nanoparticle carrier, same accumulation. After light activation: surface lesion clears ninety-four percent. Deep lesion clears three percent. Light intensity at twelve millimeters is below two percent of surface intensity. Delivery is identical. Tissue optics set the ceiling. Illustrative numbers.",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "voice": "am_onyx",
