    {
      "beat_id": "B10",
      "act": "RECAP",
      "t_start": 89.0,
      "estimated_duration_s": 10.0,
      "narration_text": "Use photodynamic therapy for lesions within the optical reach of tissue — surface and near-surface tumors. Do not use it for deeper lesions: no delivery improvement fixes a physics constraint. The ceiling is the millimeters tissue allows.",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
