    {
      "beat_id": "B03",
      "act": "THE QUESTION",
      "t_start": 18.5,
      "estimated_duration_s": 9.0,
      "narration_text": "Drug accumulation: ten times normal concentration in both tumors. Surface lesion at two millimeters clears. Lesion at fifteen millimeters does not respond. Why can't better delivery fix this?",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "voice": "am_onyx",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "form": "question-card",
        "remotion": {
          "pattern": "FormACard",
          "provenance": "proven-core/FormACard",
          "version": "1",
          "props": {
            "lines": [
              "Surface (2 mm): cleared.",
              "Deep (15 mm): no response.",
              "Same 10× delivery.",
              "Why?"
            ],
            "dark": false
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": ""
          }
        }
      },
      "new_visual_element": "[CARD] gap formula — delivery works, depth doesn't",
