      }
    },
    {
      "beat_id": "B05",
      "act": "II — the collapse",
      "t_start": 54.13,
      "narration_text": "One function at ninety percent: ninety percent pass. Add a second: eighty-one percent. A third: seventy-three percent. Four functions: sixty-six. Five: fifty-nine. Six functions, all at ninety percent each — fifty-three percent pass. More than half your batches fail.",
      "engine": "kokoro",
      "voice": "am_onyx",
      "voice_kokoro": "am_onyx",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "hold",
        "remotion": {
          "pattern": "FormACard",
          "provenance": "proven-core/FormACard",
          "version": "1",
          "props": {
            "lines": [
              "Batch yield as functions stack",
              "1 → 90%    4 → 66%",
              "2 → 81%    5 → 59%",
              "3 → 73%    6 → 53%",
              "More than half of batches fail."
            ],
            "dark": false
          },
          "rendered": {
            "out": "media/B05.mp4",
            "at": ""
          }
        }
      },
      "audio_file": "../vox-complexity-yield/mp3/beat-B05.mp3",
      "actual_duration_s": 19.91,
      "estimated_duration_s": 19.91,
      "locked": true,
      "source_audio": "../vox-complexity-yield/mp3/beat-B05.mp3",
