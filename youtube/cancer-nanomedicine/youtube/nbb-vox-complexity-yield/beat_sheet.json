    {
      "beat_id": "B03",
      "act": "I — the question",
      "t_start": 28.42,
      "narration_text": "Each of those six functions is ninety percent reproducible, batch to batch. Ninety percent. That sounds like high quality. So why does more than half of every manufactured batch fail specification?",
      "engine": "kokoro",
      "voice": "am_onyx",
      "voice_kokoro": "am_onyx",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "hold",
        "remotion": {
          "pattern": "FormACard",
          "provenance": "proven-core/FormACard",
          "version": "1",
          "props": {
            "lines": [
              "Six functions.",
              "Each 90% reproducible.",
              "Why does more than half of every batch fail?"
            ],
            "dark": false
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": ""
          }
        }
      },
      "audio_file": "../vox-complexity-yield/mp3/beat-B03.mp3",
      "actual_duration_s": 12.07,
      "estimated_duration_s": 12.07,
      "locked": true,
      "source_audio": "../vox-complexity-yield/mp3/beat-B03.mp3",
