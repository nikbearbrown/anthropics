    {
      "beat_id": "B08",
      "act": "III — the dead end",
      "t_start": 106.36,
      "narration_text": "The instinct is to fix this with better manufacturing. Hire process engineers, tighten tolerances. This is the dead end. Process engineering cannot make a six-parameter assembly as consistent as a one-parameter assembly. The math does not care about your engineers.",
      "engine": "kokoro",
      "voice": "am_onyx",
      "voice_kokoro": "am_onyx",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "hold",
        "remotion": {
          "pattern": "FormACard",
          "provenance": "proven-core/FormACard",
          "version": "1",
          "props": {
            "lines": [
              "Complexity is a design problem —",
              "not a manufacturing problem.",
              "No process engineering fixes",
              "multiplicative math."
            ],
            "dark": false
          },
          "rendered": {
            "out": "media/B08.mp4",
