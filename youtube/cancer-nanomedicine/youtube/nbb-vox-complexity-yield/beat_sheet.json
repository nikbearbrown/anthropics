            "items": [
              {
                "label": "One function",
                "sub": "Doxil, radioligands — reached patients.",
                "icon": "circle-check"
              },
              {
                "label": "Six functions",
                "sub": "Theranostic construct — did not translate.",
                "icon": "circle-x"
              }
            ],
            "dark": false
          },
          "rendered": {
