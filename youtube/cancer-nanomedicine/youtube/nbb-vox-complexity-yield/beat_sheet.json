      }
    },
    {
      "beat_id": "B04",
      "act": "II — the mechanism",
      "t_start": 40.49,
      "narration_text": "Because reproducibility does not add — it multiplies. When you need all six functions to pass specification in the same batch, the probabilities compound. Each function is a gate. Every gate must open.",
      "engine": "kokoro",
      "voice": "am_onyx",
      "voice_kokoro": "am_onyx",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "hold",
        "remotion": {
          "pattern": "FormACard",
          "provenance": "proven-core/FormACard",
          "version": "1",
          "props": {
            "lines": [
              "Reproducibility does not add — it multiplies.",
              "All six functions must pass in the same batch.",
              "Each function is a gate.",
              "Every gate must open."
            ],
            "dark": false
          },
          "rendered": {
            "out": "media/B04.mp4",
            "at": ""
          }
        }
      },
      "audio_file": "../vox-complexity-yield/mp3/beat-B04.mp3",
      "actual_duration_s": 13.64,
      "estimated_duration_s": 13.64,
      "locked": true,
      "source_audio": "../vox-complexity-yield/mp3/beat-B04.mp3",
      "build": {
