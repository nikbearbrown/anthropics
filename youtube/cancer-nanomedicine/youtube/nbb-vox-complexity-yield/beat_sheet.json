    {
      "beat_id": "B06",
      "act": "II — the math",
      "t_start": 74.04,
      "narration_text": "That calculation — point nine to the sixth power equals fifty-three percent — is not a pessimistic assumption. It is what happens at ninety percent per-function quality. Raise it to ninety-five percent per function and you still lose one batch in four.",
      "engine": "kokoro",
      "voice": "am_onyx",
      "voice_kokoro": "am_onyx",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "hold",
        "remotion": {
          "pattern": "FormACard",
          "provenance": "proven-core/FormACard",
          "version": "1",
          "props": {
            "lines": [
              "0.9 ^ 6  =  53%",
              "0.95 ^ 6  =  74%",
              "One batch in four still lost.",
              "Not pessimistic. The actual outcome."
            ],
            "dark": false
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": ""
          }
        }
      },
      "audio_file": "../vox-complexity-yield/mp3/beat-B06.mp3",
      "actual_duration_s": 15.18,
      "estimated_duration_s": 15.18,
      "locked": true,
      "source_audio": "../vox-complexity-yield/mp3/beat-B06.mp3",
