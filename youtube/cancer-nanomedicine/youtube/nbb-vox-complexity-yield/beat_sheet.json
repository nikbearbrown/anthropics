    {
      "beat_id": "B07",
      "act": "III — the contrast",
      "t_start": 89.22,
      "narration_text": "Single-function particles do not face this. Doxil carries one drug payload. Its one function to characterize: encapsulation efficiency and release rate. A radioligand has one function: labeling yield. These are the designs that reached patients.",
      "engine": "kokoro",
      "voice": "am_onyx",
      "voice_kokoro": "am_onyx",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "hold",
        "remotion": {
          "pattern": "FormBCard",
          "provenance": "proven-core/FormBCard",
          "version": "1",
          "props": {
