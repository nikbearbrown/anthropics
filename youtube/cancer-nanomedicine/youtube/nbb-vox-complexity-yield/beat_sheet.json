      "beat_id": "B01",
      "act": "I — exec summary",
      "t_start": 0.0,
      "narration_text": "A research team builds the most sophisticated nanoparticle ever. It images, it heats, it targets, it delivers drug. The paper is celebrated. More than half the manufactured batches fail.",
