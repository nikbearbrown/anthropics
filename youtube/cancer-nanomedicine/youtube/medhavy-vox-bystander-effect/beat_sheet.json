    {
      "beat_id": "B02",
      "act": "COLD OPEN",
      "estimated_duration_s": 9.0,
      "narration_text": "T-DM1 and T-DXd. Identical antibodies. One opens a new disease category. One does not. The difference cannot be in the targeting — we need to look somewhere else entirely.",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "drawon",
        "form": "text-card",
        "remotion": {
          "pattern": "FormACard",
          "provenance": "proven-core/FormACard",
          "version": "1",
          "props": {
            "lines": [
              "T-DM1  ·  T-DXd",
              "identical anti-HER2 antibodies",
              "the split is not in the targeting"
            ],
            "dark": false
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": ""
          }
        }
      },
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 12.95,
      "build": {
