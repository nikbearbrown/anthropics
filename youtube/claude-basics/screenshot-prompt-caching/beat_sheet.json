    {
      "beat_id": "B02",
      "act": "the fix — ephemeral cache_control",
      "narration_text": "The fix is one field: cache underscore control equals the type ephemeral. On the first turn, hash the screenshot and send it with that flag. The API caches it. On subsequent turns with the same image, the API returns a cache hit — instant, zero input tokens. You send the image once; the cache does the rest.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 17.0,
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Cache hit.",
            "topic": "COMPUTER USE · PROMPT CACHING",
            "segment": "Caching Pixels You've Already Seen.",
            "command": "{\n  \"type\": \"image\",\n  \"source\": {\"type\": \"base64\", \"data\": \"...\"},\n  \"cache_control\": {\"type\": \"ephemeral\"}\n}",
            "runningText": "adding cache_control…",
            "folderLabel": "@NikBearBrown",
            "modelLabel": "Claude Sonnet",
            "effortLabel": "High"
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": ""
          }
        }
      },
      "audio_file": "mp3/beat-B02.mp3",
