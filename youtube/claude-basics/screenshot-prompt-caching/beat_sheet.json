      "beat_id": "B00",
      "act": "cold open",
      "scene": "ClaudeComposerAsk",
      "narration_text": "This is Liam, in for Bear. A 50-turn computer-use task. 35 of those turns send the exact same screenshot. Every one re-tokenized. That is 70,000 tokens you paid for twice — or ten times. What if you only tokenized it once?",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 15.0,
      "shot": {
        "type": "REMOTION",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Hej, Liam",
            "topic": "COMPUTER USE · PROMPT CACHING",
            "segment": "Caching Pixels You've Already Seen.",
            "command": "My computer-use agent re-sends an identical screenshot 35 times in a 50-turn task — add prompt caching and show me the token savings.",
            "runningText": "enabling cache_control…",
            "folderLabel": "@NikBearBrown",
            "modelLabel": "Claude Sonnet",
            "effortLabel": "High",
            "outputLines": [
              "Without caching: 50 × 2000 = 100,000 tokens",
              "With caching:     5 × 2000 = 10,000 tokens",
              "Savings: 90,000 tokens (90%)"
