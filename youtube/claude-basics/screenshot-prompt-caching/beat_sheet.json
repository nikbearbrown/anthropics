    {
      "beat_id": "B01",
      "act": "the problem — redundant screenshot tokenization",
      "narration_text": "Every agent turn takes a screenshot. Most of the time the desktop has not changed. A form is still open. A progress bar is still moving. The agent sends the identical image anyway — and the API tokenizes it again from scratch. 2000 tokens times 50 turns. Most of it wasted.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 17.0,
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Redundant.",
            "topic": "COMPUTER USE · PROMPT CACHING",
            "segment": "Caching Pixels You've Already Seen.",
            "command": "50 turns × 2000 tokens/screenshot = 100,000 tokens total.\n35 of those turns: identical screenshot. 70,000 tokens re-tokenized.",
            "runningText": "counting tokens…",
            "folderLabel": "@NikBearBrown",
