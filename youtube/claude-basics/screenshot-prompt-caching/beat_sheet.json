    {
      "beat_id": "B03",
      "act": "centerpiece — the filmstrip with cache hits and misses",
      "narration_text": "Here is the 50-turn task with caching on. Five unique desktop states: A through E. Each first visit is a cache miss — 2000 tokens. Every revisit is a cache hit — near zero tokens. Total: five unique states times 2000 equals 10,000 tokens. Without caching: 100,000. The savings are 90 percent. Source: Claude Quickstarts, Anthropic.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 20.0,
