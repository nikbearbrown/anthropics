    {
      "beat_id": "B04",
      "act": "honesty beat — what this does NOT cover",
      "narration_text": "What this does not cover: the full caching protocol — token counting rules, minimum cacheable token thresholds, or cache eviction policies. The cache persists for a session; it does not persist across API keys or long idle gaps. And this is ephemeral caching: it is not the persistent cache tier. This video is the screenshot-caching case only.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 17.0,
