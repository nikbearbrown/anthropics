    {
      "beat_id": "B05",
      "act": "verdict",
      "narration_text": "Let's recap with Claude. Computer-use agents re-send the same screenshots over and over. The API re-tokenizes every one unless you tell it not to. One field — cache underscore control ephemeral — flips the behavior. The API caches on first sight, returns a hit on every repeat. In a 50-turn task with 5 unique desktop states, that is 10,000 tokens instead of 100,000.",
      "voice": "am_onyx",
      "engine": "kokoro",
