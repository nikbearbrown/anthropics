    {
      "beat_id": "B04",
      "t_start": 30.0,
      "estimated_duration_s": 12.0,
      "act": "THE PROBLEM",
      "narration_text": "Fluency and correctness are independent. An output can be clear, complete-looking, and well-structured — and still fail every criterion the task actually required. Claude produces fluent text optimized for what it has. If success criteria aren't in the prompt, Claude has no target.",
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
        "motion": "drawon",
        "media": "media/B04.mp4",
        "manim": {
