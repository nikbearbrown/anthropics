    {
      "beat_id": "B06",
      "t_start": 53.0,
      "estimated_duration_s": 11.0,
      "act": "THE MECHANISM",
      "narration_text": "The mechanism is simple. Claude's output is optimized against whatever criteria it has. Give it no criteria — it optimizes for fluency, generic completeness, and the shape of similar documents. Those are defaults. Not yours.",
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
        "motion": "drawon",
        "media": "media/B06.mp4",
        "manim": {
