    {
      "beat_id": "B00",
      "act": "cold open",
      "scene": "ClaudeComposerAsk",
      "narration_text": "Bonjour, Liam. This is Liam, in for Professor Bear. This channel runs on computational skepticism, and Popper's rule applies to your prompts too: a claim that can't be wrong isn't a claim yet. If you can't say what a bad answer would look like, you haven't written a spec. Here's why 'be more specific' doesn't actually help.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "estimated_duration_s": 17.0,
      "shot": {
        "type": "REMOTION",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Bonjour, Liam",
            "topic": "CLAUDE PROMPTING · @NikBearBrown",
            "segment": "What Is the Claude Prompting Playlist.",
            "command": "Why doesn't 'be more specific' actually help me?",
            "runningText": "identifying missing constraints…",
            "folderLabel": "@NikBearBrown",
            "modelLabel": "Claude Sonnet",
            "effortLabel": "High",
            "outputLines": [
              "Missing constraint identified: output format never specified.",
              "Missing constraint: failure case never named.",
              "Spec written. Prompt improved."
