    {
      "beat_id": "B02",
      "act": "right model",
      "scene": "PIPELINE",
      "narration_text": "The right model: prompting as writing a brief. Audience, format, constraints, what done looks like, one example. You write the spec before you see the output — that's the Popperian move.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "estimated_duration_s": 12.0,
      "shot": {
        "type": "MANIM",
        "manim": {
