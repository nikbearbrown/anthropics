    {
      "beat_id": "B01",
      "act": "wrong model",
      "scene": "PIPELINE",
      "narration_text": "The wrong model: prompting as spellcasting. Collecting phrases like 'you are an expert' and hoping one lands. Adjectives stacked on adjectives. Nothing specific about what done looks like.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "estimated_duration_s": 11.0,
      "shot": {
        "type": "MANIM",
        "manim": {
          "scene_class": "IncantationStack",
          "file": "manim/scenes.py"
        }
      },
      "audio_file": "mp3/beat-B01.mp3",
