    {
      "beat_id": "B05",
      "act": "verdict",
      "scene": "PIPELINE",
      "narration_text": "Who this is for: people who've read the prompt-hack threads and got nothing out of them. Skip it if you already write briefs for humans — same skill, different medium. Falsifiable line: if adding an explicit example and a named failure case to a prompt produces no measurable difference in output quality, the spec model is wrong.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "estimated_duration_s": 18.0,
      "shot": {
        "type": "REMOTION",
        "remotion": {
          "pattern": "ClaudeWindow",
          "props": {
            "view": "artifact",
            "artifactTitle": "Verdict",
            "artifactHeading": "Who this is for",
            "artifactLines": [
              "FOR: Read prompt-hack threads and got nothing.",
              "WHY: Magic words do not exist. Missing constraints do.",
              "FIX: Write audience, format, failure case, one example.",
              "SKIP: You already write briefs for humans? Skip.",
              "DO NOW: Add the one requirement you never said.",
              "TEST: Same prompt with a named failure case.",
              "EXPECT: Output changes on the first iteration.",
              "FALSIFIABLE: Spec adds nothing to output quality? Claim fails."
            ],
            "sparkLine": "Missing constraints, not magic words."
          },
          "rendered": {
            "out": "media/B05.mp4",
            "at": ""
          }
        }
      },
