          "file": "manim/scenes.py"
        }
      },
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 9.69,
      "build": {
        "status": "MANIM",
        "src": "manim/B02.mp4",
        "filled_by": "manim:SpecConstraints",
        "at": "2026-07-25T01:12:21"
