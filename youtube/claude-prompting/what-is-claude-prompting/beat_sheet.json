    },
    {
      "beat_id": "B03",
      "act": "what's in the playlist",
      "scene": "PIPELINE",
      "narration_text": "The playlist covers four moves: why examples beat adjectives, naming the failure you want avoided, asking for the reasoning, and iterating the spec rather than just the wording.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "estimated_duration_s": 11.0,
