    {
      "beat_id": "B05",
      "act": "verdict",
      "scene": "PIPELINE",
      "narration_text": "For teachers, and for students who want to stay good at things. This playlist never teaches anyone to get around a ban or an integrity policy — say that clearly. Falsifiable line: if students who use AI as a scaffold on this playlist's model outperform students who don't on the underlying skill, the scaffold-versus-crutch line is drawn in the right place.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "estimated_duration_s": 18.0,
      "shot": {
        "type": "REMOTION",
        "remotion": {
          "pattern": "ClaudeWindow",
          "props": {
            "view": "artifact",
            "artifactTitle": "Verdict",
            "artifactHeading": "Who this is for",
            "artifactLines": [
              "FOR: Teachers. Students who want to stay good at things.",
              "HARD RULE: This playlist never teaches anyone to evade a ban.",
              "WHY: The struggle is the curriculum. Remove it, remove the learning.",
              "FIX: Name the skill the assignment protects before deciding.",
              "SKIP: Looking for a shortcut past integrity rules? Wrong playlist.",
              "DO NOW: Pick one assignment. Write the skill it protects.",
              "TEST: Can a student hand that skill to AI undetected?",
              "FALSIFIABLE: Scaffold learners outperform non-scaffold? Line drawn correctly."
            ],
            "sparkLine": "AI that removes the struggle removes the learning."
          },
          "rendered": {
