  {
   "beat_id": "B04",
   "act": "governing equation",
   "narration_text": "Square wave as a Fourier series: four over pi, times the sum of sine of two-n-minus-one times x, divided by two-n-minus-one. Only odd harmonics. Amplitude falls as one over n. The Gibbs limit is exactly one plus one over pi — about 1.179, an overshoot of roughly 17.9 percent of the half-amplitude.",
   "voice": "am_onyx",
   "engine": "kokoro",
   "estimated_duration_s": 14,
