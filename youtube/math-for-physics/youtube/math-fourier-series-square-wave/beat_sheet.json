  {
   "beat_id": "B02",
   "act": "Manim exhibit — Fourier series convergence",
   "narration_text": "Each new term adds a higher harmonic. Watch the partial sum chase the square wave — the ringing tightens, the flanks steepen, but the overshoot at each edge stays locked near nine percent. Adding more terms compresses it but never eliminates it. Convergence and the Gibbs phenomenon, both visible at once.",
   "voice": "am_onyx",
   "engine": "kokoro",
   "estimated_duration_s": 30,
   "shot": {
    "type": "VIDEO",
    "source": "own",
    "path": "media/B02.mp4"
   },
   "audio_file": "mp3/beat-B02.mp3",
   "actual_duration_s": 16.45,
   "build": {
    "status": "VIDEO",
    "src": "media/B02.mp4",
    "filled_by": "media",
    "at": "2026-07-27T18:26:18"
   }
  },
  {
   "beat_id": "B03",
   "act": "key insight",
   "narration_text": "The series converges everywhere except at the discontinuities. At the jumps, the sum always overshoots by about nine percent of the jump height, regardless of how many terms you include. This is not an approximation error — it is a mathematical fact about Fourier convergence at discontinuities.",
   "voice": "am_onyx",
   "engine": "kokoro",
   "estimated_duration_s": 14,
   "shot": {
    "type": "REMOTION",
    "source": "remotion",
    "remotion": {
