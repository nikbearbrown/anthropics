  {
   "beat_id": "B01",
   "act": "FOUR-OPERATIONS",
   "narration_text": "Four operations ranked by risk: organizing — chronological structure, no interpretation, lowest risk. Summarizing — compression with selection, moderate risk. Synthesizing — integrating across multiple speakers, higher risk. Deciding — resolving discussion into commitment, the human's job. Cowork performs all four fluently. The output does not announce which operation is happening. The brief must restrict the task to the operation you authorized.",
   "shot": {
    "type": "REMOTION",
    "source": "own",
    "remotion": {
     "pattern": "CoworkTaskView",
     "props": {
      "blocks": [
       {
        "type": "prompt",
