  {
   "beat_id": "B00",
   "act": "ASK",
   "narration_text": "She asked Cowork to summarize Tuesday's strategy meeting notes with action items. The summary arrived — polished, organized, every action item named with an owner. Three people pushed back the next day. Two action items had been assigned to team members who had not been in the room for the discussion that produced them. One item marked 'decided' had been tabled. The notes sounded authoritative. They had not recorded what was decided. They had decided what was recorded. This is Liam, in for Bear.",
   "shot": {
    "type": "REMOTION",
    "source": "own",
    "remotion": {
     "pattern": "ClaudeComposerAsk",
     "props": {
      "greeting": "Liam",
      "topic": "MEETING NOTES · COWORK",
      "segment": "Organizing vs. Deciding: Meeting Notes That Misrepresent",
      "command": "What is: Organizing vs. Deciding: Meeting Notes That Misrepresent?",
      "runningText": "building the answer…",
      "output": [],
      "folderLabel": "@NikBearBrown"
     },
     "rendered": {
