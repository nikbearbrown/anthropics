    {
      "beat_id": "B06",
      "act": "II — The Map",
      "narration_text": "The audit maps four layers: server versus client component boundaries. Edge versus Node runtimes. Redirects, rewrites, and the proxy file. And every place the code reads an environment variable. Those are the load-bearing walls.",
      "new_visual_element": "The four-layer boundary map",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "remotion": {
          "pattern": "VRLayerStack",
          "props": {
            "sparkLine": "the load-bearing walls.",
            "layers": [
              {
                "title": "Server / Client Components",
                "sub": "'use client' boundaries — crossing one changes runtime behavior"
              },
              {
                "title": "Edge vs Node Runtimes",
                "sub": "edge functions cannot import Node-only modules"
              },
              {
                "title": "Routing Config + Proxy",
                "sub": "redirects, rewrites, proxy.ts (was middleware.ts in Next 16)",
                "accent": true
              },
              {
                "title": "Environment Variables",
                "sub": "server-only vs client-exposed env vars"
              }
            ],
            "top": 118
