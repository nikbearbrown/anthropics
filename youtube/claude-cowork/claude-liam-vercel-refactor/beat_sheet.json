          "pattern": "ClaudeCodeBeat",
          "props": {
            "title": "gate.sh",
            "code": "pnpm exec eslint .\npnpm exec tsc --noEmit\npnpm test\npnpm exec next build",
            "sparkLine": "four commands, not optional."
          },
          "rendered": {
