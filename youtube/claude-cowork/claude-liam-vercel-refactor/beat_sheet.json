    {
      "beat_id": "B17",
      "act": "V — Where Cowork Leads",
      "narration_text": "When outside systems are involved, Cowork has a documented priority order: connectors first, browser second, screen interaction last. Design references in Drive or SharePoint come through connectors — not through brittle clicking. That errand never belonged in your git loop anyway.",
      "new_visual_element": "Connectors-first priority order",
