  {
   "beat_id": "B00",
   "act": "ASK",
   "narration_text": "He asked Cowork to assemble the weekly status report. He pasted the prompt from last week. Cowork produced a report — longer than usual, with items from last quarter in the summary. The source folder had accumulated three months of notes. The prompt said 'summarize the weekly notes.' It did not say which week. Without the packet, the task had no scope. Cowork guessed. This is Liam, in for Bear.",
   "shot": {
    "type": "REMOTION",
    "source": "own",
    "remotion": {
     "pattern": "ClaudeComposerAsk",
     "props": {
      "greeting": "Liam",
