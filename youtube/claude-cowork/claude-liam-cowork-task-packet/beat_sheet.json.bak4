  {
   "beat_id": "B01",
   "act": "FIVE-FIELDS",
   "narration_text": "The task packet has five fields. Inputs named: the specific files or folders Cowork may read. Folder access limited: the explicit paths — not broader than needed. Forbidden actions: no sending, no sharing, no accessing paths not listed. Output file specified: name and location. Verification criteria implicit or stated: what makes the output correct. These five fields are what separate a scoped task from a guess.",
   "shot": {
    "type": "REMOTION",
    "source": "own",
    "remotion": {
     "pattern": "CoworkTaskView",
     "props": {
      "blocks": [
       {
        "type": "prompt",
        "text": "The task packet has five fields. Inputs named: the specific files or folders Cowork may read. Folder…"
       },
       {
        "type": "review",
        "items": [
         {
          "title": "The task packet has five fields.",
          "badge": "Fact",
          "badgeTone": "neutral"
         },
         {
          "title": "Inputs named: the specific files or folders Cowork may read.",
          "badge": "Fact",
          "badgeTone": "neutral"
         },
         {
          "title": "Folder access limited: the explicit paths — not broader than needed.",
          "badge": "Warning",
          "badgeTone": "warn"
         },
         {
          "title": "Forbidden actions: no sending, no sharing, no accessing paths not listed.",
          "badge": "Warning",
          "badgeTone": "warn"
         }
        ]
       }
      ],
