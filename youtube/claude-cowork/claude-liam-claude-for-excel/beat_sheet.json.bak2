    {
      "beat_id": "B06",
      "t_start": 50.0,
      "estimated_duration_s": 9.0,
      "narration_text": "If spreadsheets are your full-time job, there is another tool worth knowing: Shortcut dot ai. It is built exclusively for spreadsheets and aims to replace both Microsoft and Google. It does not carry the same deep context that Cowork does, but it is a real alternative if you are building sheets all day.",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "hold",
