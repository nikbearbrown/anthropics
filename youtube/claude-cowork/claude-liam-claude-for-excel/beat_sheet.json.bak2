    {
      "beat_id": "B05",
      "t_start": 41.0,
      "estimated_duration_s": 9.0,
      "narration_text": "The ChatGPT extension inside Google Sheets is genuinely good for editing. You reference a tab or a cell range, write a plain-English instruction, and it adjusts the data. For example: change the bull scenario in Assumptions to be more optimistic, with realistic numbers. That kind of targeted edit works beautifully inside Sheets.",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "hold",
        "remotion": {
          "pattern": "CoworkComposer",
          "props": {
            "typedText": "Change the bull scenario in Assumptions to be more optimistic, with realistic numbers",
            "heading": "ChatGPT edits. Cowork creates.",
            "subline": "Reference a tab or cell range, write a plain-English instruction.",
            "chips": {
              "scope": "Sheets",
              "mode": "Edit"
            }
          },
          "rendered": {
            "out": "media/B05.mp4",
            "at": ""
          }
        }
      },
      "card": {
        "kind": "spark",
