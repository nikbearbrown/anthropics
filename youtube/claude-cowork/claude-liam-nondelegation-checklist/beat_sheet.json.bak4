   "new_visual_element": "HANDOFF \u2014 nondelegation checklist prompt",
   "remotion": {
    "pattern": "ClaudeComposerAsk",
    "props": {
     "greeting": "Your turn.",
     "topic": "DELEGATION LIMITS \u00b7 COWORK",
     "segment": "The Nondelegation Checklist",
     "command": "Before I delegate this task, help me check: (1) Does it involve identifiable educational, health, legal, or financial records? (2) Does it require professional judgment about specific individuals? (3) Does it include irreversible external actions \u2014 send, submit, delete, publish? (4) Is the data exposure itself a problem, regardless of output quality? If any answer is yes, suggest a redesign that reduces data, scope, or action to remove the problem \u2014 not a workaround that still processes the sensitive material.",
     "runningText": "paste this into Claude\u2026",
     "folderLabel": "@NikBearBrown"
    }
