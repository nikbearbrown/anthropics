 "beats": [
  {
   "beat_id": "B00",
   "act": "ASK",
   "narration_text": "She asked Cowork to categorize student accommodation files by risk level so advisors would know who to prioritize. Cowork could do it. The folder was right there. Cowork can read PDFs. She did not ask the question she needed to ask first \u2014 not can Cowork do this, but should Cowork do this. The files were FERPA-protected educational records. The risk categorization was professional judgment. The data exposure happened the moment the files entered the session. This is Liam, in for Bear.",
   "shot": {
    "type": "REMOTION",
    "source": "own",
    "remotion": {
     "pattern": "ClaudeComposerAsk",
     "props": {
      "greeting": "Liam",
      "topic": "DELEGATION LIMITS \u00b7 COWORK",
      "segment": "Nondelegation Checklist: Can vs. Should",
      "command": "What is: Nondelegation Checklist: Can vs. Should?",
      "runningText": "building the answer\u2026",
      "output": [],
      "folderLabel": "@NikBearBrown"
     },
     "rendered": {
      "out": "media/B00.mp4",
      "at": ""
     }
    }
   },
