  {
   "beat_id": "B07",
   "t_start": 59.0,
   "estimated_duration_s": 10.0,
   "narration_text": "The daily workflow is two apps, one folder. Open Obsidian to browse, search, read, and edit your files. Open Cowork to build new work and generate outputs. Both look at the same folder. Always in sync. Obsidian is where you update the brain. Cowork is where you build. You can also add a Skills folder \u2014 one file per repeated task, each callable with a slash command.",
   "shot": {
    "type": "REMOTION",
    "source": "own",
    "motion": "hold",
    "remotion": {
     "pattern": "CoworkTaskView",
     "props": {
      "blocks": [
       {
