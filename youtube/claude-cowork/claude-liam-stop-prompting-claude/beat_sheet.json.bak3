  {
   "beat_id": "B01",
   "t_start": 0.0,
   "estimated_duration_s": 9.0,
   "narration_text": "Konnichiwa. This is Liam, in for Bear. What if you never had to type a long prompt again? What if Claude already knew everything about you \u2014 before the first word? The files are the prompt. Let me show you.",
   "shot": {
    "type": "COMPOSER_ASK",
    "source": "own",
    "motion": "type",
    "scene_type": "ClaudeComposerAsk",
    "remotion": {
     "pattern": "ClaudeComposerAsk",
     "props": {
      "ask": "Write a LinkedIn post in my voice.",
      "answer_preview": "Claude already knows your tone, your rules, your goals \u2014 because it read your files first.",
      "command": "What if you never had to type a long prompt again?",
      "greeting": "Konnichiwa. This is Liam"
     },
     "rendered": {
      "out": "media/B01.mp4",
      "at": ""
     }
    }
   },
   "new_visual_element": "[COMPOSER] cold open ask + Liam sign-in",
   "build": {
    "status": "SLATE",
    "src": null,
    "filled_by": null
   },
   "actual_duration_s": 10.67,
   "audio_file": "mp3/beat-B01.mp3"
  },
  {
   "beat_id": "B02",
   "t_start": 9.0,
   "estimated_duration_s": 9.0,
   "narration_text": "Claude Cowork connects to a folder on your computer. You save text files in that folder \u2014 your style, your rules, your goals. Claude reads them automatically before every session. The files are the prompt. Forever. No more 500-word instruction blocks every time you start a chat.",
   "shot": {
    "type": "REMOTION",
    "source": "own",
    "motion": "hold",
    "remotion": {
     "pattern": "CoworkComposer",
     "props": {
      "typedText": "Always read about-me, leave the rest alone",
      "heading": "Files are the prompt.",
      "subline": "Save style, rules, and goals as .md files. Claude reads them before every session.",
      "chips": {
       "scope": "Work",
       "mode": "Research"
      }
     },
     "rendered": {
      "out": "media/B02.mp4",
      "at": ""
     }
    }
   },
   "card": {
    "kind": "spark",
    "eyebrow": "CLAUDE COWORK",
    "copy": "Files are the prompt.",
    "sub": "Save your style, rules, and goals as .md files. Claude reads them before every session \u2014 automatically.",
    "accent": "#D97757"
   },
   "new_visual_element": "[SPARK] Cowork core concept",
   "build": {
    "status": "SLATE",
