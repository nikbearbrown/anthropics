    "filled_by": null
   },
   "actual_duration_s": 15.13,
   "audio_file": "mp3/beat-B02.mp3"
  },
  {
   "beat_id": "B03",
   "t_start": 18.0,
   "estimated_duration_s": 10.0,
   "narration_text": "The Cowork folder structure: three subfolders. About-me \u2014 three files: about-me, anti-ai-writing-style, my-company. Claude-output \u2014 you never touch this; it's where Claude stores its work. Templates \u2014 you never touch this either; it's where your favourite work formats live. Set up Global Instructions to tell Claude: always read about-me, leave the rest alone.",
   "shot": {
    "type": "REMOTION",
    "source": "own",
    "motion": "drawon",
    "remotion": {
     "pattern": "CoworkSideRail",
     "props": {
      "folders": [
       {
        "label": "Claude Cowork",
        "depth": 0,
        "open": true
       },
       {
        "label": "about-me",
        "depth": 1,
        "open": true,
        "hi": true
       },
       {
        "label": "about-me.md",
        "depth": 2,
        "fileMeta": "edit me"
       },
       {
        "label": "anti-ai-writing-style.md",
        "depth": 2
       },
       {
        "label": "my-company.md",
        "depth": 2
       },
       {
        "label": "claude-output",
        "depth": 1,
        "open": false
       },
       {
        "label": "templates",
        "depth": 1,
        "open": false
       }
      ],
      "contextNote": "Global Instructions: always read about-me"
     },
     "rendered": {
      "out": "media/B03.mp4",
      "at": ""
     }
    }
   },
