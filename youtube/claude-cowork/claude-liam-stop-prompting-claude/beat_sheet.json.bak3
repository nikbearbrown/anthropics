  {
   "beat_id": "B04",
   "t_start": 28.0,
   "estimated_duration_s": 9.0,
   "narration_text": "The problem: managing .md files is genuinely annoying. You double-click one, it opens a geeky text editor full of hashtags and asterisks. Hard to read. Hard to edit. Most people set up Cowork once, then never touch their files again. So the context goes stale.",
   "shot": {
    "type": "REMOTION",
    "source": "own",
    "motion": "hold",
    "remotion": {
     "pattern": "CoworkTaskView",
     "props": {
      "blocks": [
       {
        "type": "prompt",
        "text": "Open about-me.md"
       },
       {
        "type": "toolline",
        "text": "Opens a text editor full of hashtags and asterisks",
        "spinner": false
       },
       {
        "type": "review",
        "items": [
         {
          "title": "Hard to read \u2014 raw markdown",
          "badge": "Problem",
          "badgeTone": "warn"
         },
         {
          "title": "Hard to edit \u2014 most skip updates",
          "badge": "Problem",
          "badgeTone": "warn"
         },
         {
          "title": "Context goes stale \u2192 generic output",
          "badge": "Problem",
          "badgeTone": "fail"
         }
        ]
