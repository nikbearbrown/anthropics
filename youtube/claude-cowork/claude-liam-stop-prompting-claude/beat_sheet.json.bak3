  {
   "beat_id": "B05",
   "t_start": 37.0,
   "estimated_duration_s": 10.0,
   "narration_text": "The fix is Obsidian. It's free. You point it at your Cowork folder and it turns every file into a beautifully rendered document \u2014 headers, bold, bullet points. A sidebar to navigate. Search across everything. You click a file, edit it right there. It saves back to the same folder Cowork reads. One edit in Obsidian, Claude knows instantly.",
   "shot": {
    "type": "REMOTION",
    "source": "own",
    "motion": "hold",
    "remotion": {
     "pattern": "CoworkComposer",
     "props": {
      "typedText": "Open folder as vault \u2192 point at Cowork folder",
      "heading": "Obsidian. It's free.",
      "subline": "Every .md file becomes a clean, editable doc. Edit \u2192 Claude knows immediately.",
      "hint": "One edit in Obsidian, Claude knows instantly."
     },
     "rendered": {
      "out": "media/B05.mp4",
      "at": ""
     }
    }
   },
   "card": {
    "kind": "spark",
    "eyebrow": "CLAUDE COWORK",
    "copy": "Obsidian. It's free.",
    "sub": "Point it at your Cowork folder. Every .md file becomes a clean, editable doc. Edit \u2192 Claude knows immediately.",
    "accent": "#D97757"
   },
   "new_visual_element": "[SPARK] Obsidian as the fix",
   "build": {
    "status": "SLATE",
    "src": null,
    "filled_by": null
   },
   "actual_duration_s": 18.24,
   "audio_file": "mp3/beat-B05.mp3"
  },
  {
   "beat_id": "B06",
   "t_start": 47.0,
   "estimated_duration_s": 12.0,
   "narration_text": "Why Obsidian and not the others? Notion: cloud-based, stores everything in its own database, you'd have to re-import every time Cowork updates a file. Google Docs: not .md files, constant conversion back and forth. VS Code: for developers. GitHub: requires git, commits, pushes. Obsidian wins because it reads your existing folder directly. No import. No sync. No hidden metadata injected. Your .md files stay exactly as Cowork expects them.",
   "shot": {
    "type": "REMOTION",
    "source": "own",
    "motion": "drawon",
    "remotion": {
     "pattern": "CoworkTaskView",
     "props": {
      "blocks": [
       {
        "type": "section",
        "text": "Why Obsidian wins"
       },
       {
        "type": "review",
        "items": [
         {
          "title": "Notion",
          "badge": "Cloud DB \u2014 re-import every time",
          "badgeTone": "fail"
         },
         {
          "title": "Google Docs",
          "badge": "Not .md \u2014 constant conversion",
          "badgeTone": "fail"
         },
         {
          "title": "VS Code",
          "badge": "For developers",
          "badgeTone": "warn"
         },
         {
          "title": "GitHub",
          "badge": "Requires git commits",
          "badgeTone": "warn"
         },
         {
          "title": "Obsidian",
          "badge": "Reads folder directly \u2014 no import",
          "badgeTone": "pass"
         }
        ]
       }
      ],
      "cues": [
       0,
       10,
       22,
       34,
       46,
       60
      ]
     },
     "rendered": {
      "out": "media/B06.mp4",
      "at": ""
