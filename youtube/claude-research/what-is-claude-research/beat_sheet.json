      "beat_id": "B00",
      "act": "cold open",
      "scene": "ClaudeComposerAsk",
      "narration_text": "Yassou, Liam. This is Liam, in for Professor Bear. This channel runs on computational skepticism, and here's the trap it exists for: a wrong answer in a credible format is more dangerous than one that looks wrong, because it disarms the check. Citations arrive in a credible format. Here's how to use Claude for research without laundering a hallucination into your work.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "estimated_duration_s": 20.0,
      "shot": {
        "type": "REMOTION",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Yassou, Liam",
