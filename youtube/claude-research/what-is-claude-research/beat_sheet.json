    {
      "beat_id": "B02",
      "act": "right model",
      "scene": "PIPELINE",
      "narration_text": "The right model: ask for sources, read them yourself, use Claude to check your reading rather than replace it. Claude finds the thread; you pull it. The verification stays yours — that's the asymmetry.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "estimated_duration_s": 13.0,
      "shot": {
        "type": "MANIM",
        "manim": {
          "scene_class": "SourceDetour",
          "file": "manim/scenes.py"
        }
      },
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 10.84,
      "build": {
        "status": "MANIM",
        "src": "manim/B02.mp4",
