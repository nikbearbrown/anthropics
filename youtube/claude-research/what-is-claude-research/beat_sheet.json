    {
      "beat_id": "B05",
      "act": "verdict",
      "scene": "PIPELINE",
      "narration_text": "Who this is for: anyone whose work gets checked by someone else. If nobody ever checks your citations, this playlist will feel like paranoia — right up until someone does. Falsifiable line: if Claude's citations reliably point to sources that say what the citation claims, the verification step costs more than it saves.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "estimated_duration_s": 16.0,
      "shot": {
        "type": "REMOTION",
        "remotion": {
          "pattern": "ClaudeWindow",
          "props": {
            "view": "artifact",
            "artifactTitle": "Verdict",
            "artifactHeading": "Who this is for",
            "artifactLines": [
              "FOR: Anyone whose work gets checked by someone else.",
              "WHY: A fluent citation format disarms the check.",
              "FIX: Route claims through primary sources before publishing.",
              "SKIP: Nobody ever checks your citations? Until they do.",
              "DO NOW: Find the primary source for your last claim.",
              "TEST: Does the source say what the citation claims?",
              "EXPECT: At least one number attached to the wrong report.",
              "FALSIFIABLE: Citations reliably accurate? Verification costs more than it saves."
            ],
            "sparkLine": "A wrong answer in a credible format disarms the check."
          },
          "rendered": {
            "out": "media/B05.mp4",
            "at": ""
          }
        }
